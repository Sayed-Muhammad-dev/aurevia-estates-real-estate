# Keep each application database separate from your live portfolio.
# Local development uses .app-data/state.json when this is empty.
DATABASE_URL=
# Optional durable disk directory for a persistent Node host:
APP_DATA_DIR=
# Local bootstrap defaults generate a private random password:
OWNER_EMAIL=owner@aurevia.local
OWNER_NAME=Workspace Owner
# OWNER_PASSWORD=your-private-password-of-at-least-12-characters
# API_PORT=5310
